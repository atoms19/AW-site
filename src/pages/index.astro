---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.tsx';
import Skills from '../components/Skills.tsx';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import {Image} from "astro:assets"
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		  <main>
			 <header class="hero">
			  <div class="profile">
          <div class="profile-img" src="" width=70px height=70px alt="profile pic">
          <div class="prof-o">
				  <div class="prof-n"></div>
			  </div> 
			 </header>
			 <h1 class="tit">atoms19</h1>
			 <h3 class="sub">Full Stack Engineer</h3>
			 <p>Hello I am atoms, I build stuff in the web , Im currently prusing a Bachelors degree in Computer Science Engineering, I love computer programming 
			 ,I love to work with distributed systems and servers</p>

			 <div style="width:100%;display:flex;justify-content:center;gap:1rem;">
            <a href="/hire"><button class="special"></button></a>
			 </div>

			 <h2>Skills</h2> 
			 <Skills/> 
		  </main>
		<Footer />
	</body>
</html>


<style>
     h1.tit{
		 margin-bottom:0rem;
		}

	  h3.sub{
		 margin-top:0.5rem;
		 font-size:1.2rem;
		 color:#888;
	  }
		.hero{
		  padding:1rem 0rem;

		}
		.profile-img{
		     width:9rem;
		     height:9rem;
			  display:flex;
			  background:#bbaffa;
			  /* background-image: linear-gradient(to right top, #584b96, #7063ae, #897bc7, #a195e0, #bbaffa); */
			  border-radius:50%;
			  justify-content:center;
			  align-items:center;
			  margin:0;
			  --ringcolor:#372c73;
		}
		.prof-o,.prof-o2{
		    border:solid 0.1rem var(--ringcolor);
			   border-radius:50%;
				  padding:2rem;
		}
		.prof-o{
		    position:relative;
			   animation:rotate 2.9s linear infinite;
		}
		.prof-o:after{
		    border-radius:50%;
			 background:var(--ringcolor);
				  padding:0.4rem;
				    content:"";
					   position: absolute;
						  top:-8%;
						   
		}
		.prof-o:before{
		    border-radius:50%;
			   background:var(--ringcolor);
				  padding:0.4rem;
				    content:"";
					   position: absolute;
						  bottom:-8%;
						    
		}
		.prof-n{
		    padding:0.8rem;
			   background:var(--ringcolor);
				  border-radius:50%;
				    opacity:0.97;
		}
		.prof-o2{
		    padding:1rem;
		}

		.profile{
		    padding-top:3rem;
			   display:flex;
				  justify-content:center;
		}
@keyframes rotate{
  0%{
    transform:rotate (0deg);
  }
  100%{
    transform:rotate(360deg);
  }
}

		</style>


